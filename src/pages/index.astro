---
import BaseLayout from "../layouts/BaseLayout.astro";
import BeerMenuEntry from "../components/BeerMenuEntry.astro";
import MistParticlesFireflies from "../components/MistParticlesFireflies.astro";

const beers = [
  {
    name: "Dark Lodge IPA",
    type: "India Pale Ale",
    abv: 6.8,
    ibu: 65,
    description:
      "Citrus and pine, with a lingering smoky finish.",
    color: "#D2691E",
    available: true,
  },
  {
    name: "Midnight Porter",
    type: "Robust Porter",
    abv: 5.4,
    ibu: 35,
    description:
      "Velvety chocolate and roasted coffee.",
    color: "#2F1B14",
    available: true,
  },
  {
    name: "Copper Log Lager",
    type: "Vienna Lager",
    abv: 4.8,
    ibu: 22,
    description:
      "Crisp and clean, with subtle malt sweetness and earthy notes.",
    color: "#B87333",
    available: true,
  },
  {
    name: "Red Room Ale",
    type: "American Red Ale",
    abv: 5.9,
    ibu: 40,
    description:
      "A caramel backbone with lingering floral notes.",
    color: "#A0522D",
    available: false,
  },
  {
    name: "Twin Peaks Wheat",
    type: "Hefeweizen",
    abv: 4.2,
    ibu: 15,
    description:
      "Light and cloudy, with banana and clove.",
    color: "#F4A460",
    available: true,
  },
  {
    name: "Lodge Stout",
    type: "Imperial Stout",
    abv: 8.2,
    ibu: 55,
    description:
      "Deep roasted character, with vanilla and oak.",
    color: "#1C1C1C",
    available: true,
  },
];

const onTap = beers.filter((beer) => beer.available);
const comingSoon = beers.filter((beer) => !beer.available);

const events = [
  {
    date: "July 4",
    title: "Independence Day Celebration",
    description: "Celebrating with an explosive brew that proudly stands on its own",
  },
  {
    date: "July 15",
    title: "Mystery Beer Release",
    description: "Unveiling our latest creation - a beer shrouded in mystery",
  },
  {
    date: "July 22",
    title: "Trivia Night",
    description: "Test your knowledge of mysteries, both solved and unsolved",
  },
  {
    date: "July 29",
    title: "Live Jazz Evening",
    description:
      "Sultry sounds to accompany your evening libations with friends",
  },
];
---

<BaseLayout
  title="Black Lodge Brews - Premium Craft Brewery"
  description="Enter the mysterious world of Black Lodge Brews, where every sip tells a story and every brew holds secrets waiting to be discovered."
>

  <!-- Full-width photographic hero -->
  <section class="hero section" id="lodge" aria-labelledby="hero-title">
    <img class="hero-image" src="/images/beer-1.avif" width="1200" height="855"
      alt="Two glasses of amber beer on a dark wooden table" fetchpriority="high" />
    <div class="hero-content">
      <p class="hero-eyebrow">Brewery & Taproom · Est. 2023</p>
      <h1 class="hero-title" id="hero-title">Black Lodge<br />Brews</h1>
      <p class="hero-subtitle">Histories poured into every glass.</p>
    </div>
  </section>

  <!-- Tap List Section -->
  <section id="taps" class="section taps-section" aria-labelledby="taps-title">
    <div class="container">
      <header class="tap-menu-heading">
        <h2 id="taps-title">On Tap</h2>
        <p>The current selection at the Lodge.</p>
      </header>

      <ul class="tap-menu" aria-label="Beers on tap" role="list">
        {onTap.map((beer) => <BeerMenuEntry {...beer} />)}
      </ul>

      {comingSoon.length > 0 && (
        <div class="tap-menu-coming">
          <h2 id="coming-soon-title">Coming soon</h2>
          <ul class="tap-menu" aria-labelledby="coming-soon-title" role="list">
            {comingSoon.map((beer) => <BeerMenuEntry {...beer} />)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Our Story Section -->
  <section id="story" class="section story-section">
    <div class="parallax-bg story-bg" data-speed="0.5"></div>
    <div class="container">
      <div class="story-content">
        <div class="story-text">
          <h2>The Legend of Black Lodge</h2>
          <p>
            Founded in 2023 deep in the Pacific Northwest, Black Lodge brews small-batch ales inspired by the dark, ancient forests around us. We partner with local family farms for our ingredients, blending rigorous craft with a touch of the unexpected.
          </p>

          <p>
            Our taproom reflects that same craft. Built from reclaimed timber and local stone, the space houses our brewhouse alongside oddities and curiosities picked up along the way. It’s a warm spot to grab a mug, sit by the shadow of the pines, and stay awhile.
          </p>
        </div>
      </div>
    </div>
    <MistParticlesFireflies
      particleCount={10}
      color="#C8920A"
      size={1}
      speed={0.05}
      opacity={0.3}
    />
  </section>

  <!-- Taproom Section -->
  <section id="taproom" class="section taproom-section" aria-labelledby="taproom-title">
    <img class="taproom-image" src="/images/taproom.jpg" width="1200" height="983"
      alt="A timber-lined taproom with a long bar, warm pendant lights, and communal tables"
      loading="lazy" decoding="async" />

    <div class="container">
      <header class="taproom-heading">
        <h2 id="taproom-title">The Taproom</h2>
        <!-- <p>Pull up a chair.</p> -->
      </header>

      <div class="taproom-introduction">
        <h3>Stay a while.</h3>
        <p>A fresh pour at the bar. A table shared with friends. Settle in for
          an evening of beer, conversation, and music at the Lodge.</p>
      </div>

      <div class="taproom-programme">
        <h3>Upcoming Events</h3>
        <ul class="taproom-events">
          {events.map((event) => (
            <li class="taproom-event">
              <span class="taproom-date">{event.date}</span>
              <div class="taproom-event-copy">
                <h4>{event.title}</h4>
                <p>{event.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section contact-section">
    <div class="parallax-bg contact-bg" data-speed="0.3"></div>
    <div class="container">
      <h2 class="section-title">Find Your Way to the Lodge</h2>

      <div class="contact-content">
        <div class="contact-info">
          <div class="contact-item">
            <h3>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="#C8920A"
                class="contact-icon"
                ><path
                  fill-rule="evenodd"
                  d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                  clip-rule="evenodd"></path></svg
              > Location
            </h3>
            <p>312 Loggers Lane<br />Portland, OR 97210</p>
          </div>

          <div class="contact-item">
            <h3>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="#C8920A"
                class="contact-icon"
                ><path
                  d="M10.5 18.75a.75.75 0 0 0 0 1.5h3a.75.75 0 0 0 0-1.5h-3Z"
                ></path><path
                  fill-rule="evenodd"
                  d="M8.625.75A3.375 3.375 0 0 0 5.25 4.125v15.75a3.375 3.375 0 0 0 3.375 3.375h6.75a3.375 3.375 0 0 0 3.375-3.375V4.125A3.375 3.375 0 0 0 15.375.75h-6.75ZM7.5 4.125C7.5 3.504 8.004 3 8.625 3h6.75c.621 0 1.125.504 1.125 1.125v15.75c0 .621-.504 1.125-1.125 1.125h-6.75A1.125 1.125 0 0 1 7.5 19.875V4.125Z"
                  clip-rule="evenodd"></path></svg
              > Phone
            </h3>
            <p>(503) 755-BREW</p>
          </div>

          <div class="contact-item">
            <h3>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="#C8920A"
                class="contact-icon"
                ><path
                  fill-rule="evenodd"
                  d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z"
                  clip-rule="evenodd"></path></svg
              > Hours
            </h3>
            <p>
              Monday - Thursday: 4pm - 10pm<br />
              Friday - Saturday: 2pm - 12am<br />
              Sunday: 2pm - 9pm
            </p>
          </div>
        </div>

        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d11179.794472859286!2d-122.69833!3d45.52306!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x549509fc2302c4ad%3A0x23b6b67b7be6d6d1!2sPearl%20District%2C%20Portland%2C%20OR!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Black Lodge Brews Location - Portland, OR"
          >
          </iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @import "../styles/global.scss";
  @import "../styles/home-page";
  

</style>

<script>
  // GSAP ScrollTrigger Parallax Implementation
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Register ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", () => {
    new GSAPParallaxController();
  });

  // Professional parallax implementation
  class GSAPParallaxController {
    constructor() {
      this.initParallax();
    }

    initParallax() {
      // Wait for DOM to be fully loaded
      gsap.set('.parallax-bg', { transformOrigin: 'center center' });

      // Story section parallax
      gsap.to('.story-bg', {
        y: '-30%',
        ease: 'none',
        scrollTrigger: {
          trigger: '.story-section',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1, // Smooth scrubbing
          invalidateOnRefresh: true,
        }
      });

      // Contact section parallax with different speed
      gsap.to('.contact-bg', {
        y: '-20%',
        ease: 'none',
        scrollTrigger: {
          trigger: '.contact-section',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.2, // Slightly different scrub for variation
          invalidateOnRefresh: true,
        }
      });

      // Refresh ScrollTrigger on window resize
      window.addEventListener('resize', () => {
        ScrollTrigger.refresh();
      });
    }
  }

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new GSAPParallaxController();
  });

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', () => {
    new GSAPParallaxController();
  });

</script>
